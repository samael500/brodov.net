{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ site.Title }}</title><link>{{ site.Home.Permalink }}</link><description>{{ site.Params.description }}</description><language>ru</language><atom:link href="{{ `index.xml` | absURL }}" rel="self" type="application/rss+xml"/>
{{ $pages := where site.RegularPages "Section" "in" (slice "posts" "shorts") }}
{{ if not .IsHome }}{{ $pages = where .RegularPagesRecursive "Section" "in" (slice "posts" "shorts") }}{{ end }}
{{ range $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ if eq .Type "shorts" }}{{ $p := . }}{{ $caption := "" }}{{ range .Params.frames }}{{ if .caption }}{{ $caption = printf "%s %s" $caption .caption }}{{ end }}{{ end }}{{ $html := printf "<p>%s</p>" (htmlEscape $caption) }}{{ with .Resources.GetMatch .Params.cover.src }}{{ $w := int (math.Min .Width 640) }}{{ $image := .Resize (printf "%dx webp" $w) }}{{ $html = printf "%s<img src=%q alt=%q width=%q height=%q>" $html $image.Permalink ($p.Params.cover.alt | default $p.Title) (string $image.Width) (string $image.Height) }}{{ end }}{{ $html }}{{ else }}{{ .Description }}{{ end }}</description></item>{{ end }}</channel></rss>
